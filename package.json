{
  "name": "@mosdev/nestjs-zod-fixtures",
  "version": "0.0.1",
  "description": "Zod-based fixtures for NestJS applications",
  "private": true,
  "author": "Joost Lubach <joostlubach@gmail.com>",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "pnpm clean && pnpm build:tsc",
    "build:tsc": "tsc -p tsconfig.prod.json",
    "clean": "rimraf dist",
    "lint": "eslint src --ext .ts",
    "check": "tsc -p . --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/lodash": "^4.17.20",
    "@typescript-eslint/eslint-plugin": "^8.61.0",
    "buffer": "^6.0.3",
    "copyfiles": "^2.4.1",
    "globals": "^16.4.0",
    "rimraf": "^6.0.1",
    "tsc-alias": "^1.8.16",
    "typescript": "5.8.3",
    "vitest": "^4.0.18",
    "yaml": "^2.8.2"
  },
  "peerDependencies": {
    "typeorm": "*"
  },
  "dependencies": {
    "lodash": "^4.17.21",
    "@mosdev/typeorm-zod": "workspace:^",
    "@mosdev/ytil": "workspace:^"
  }
}
